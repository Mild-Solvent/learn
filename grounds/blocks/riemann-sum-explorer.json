{
 "summary": "Ready mini app: rectangles approximating the area under any function, with left/middle/right rule, n slider and error readout.",
 "file": "*.html",
 "how_to_use": "A finished html-mini-app. Copy it as is into the learner's integration folder (for example Math/Integrals/riemann-explorer.html) and show_file it. Change the default function, a and b in the input values to match the lesson (value=\"x^2\", a=0, b=2). The learner can type any math.js function.",
 "example": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Riemann sum explorer</title>\n<script src=\"https://cdn.jsdelivr.net/npm/mathjs@13.0.0/lib/browser/math.js\"></script>\n<style>\n  :root { --bg:#f6f6fb; --panel:#fff; --line:#e2e2ec; --text:#1d1d2b; --muted:#6a6a80; --accent:#5b5bd6; --fill:rgba(91,91,214,.25); --curve:#e5484d; --grid:#ececf3; }\n  @media (prefers-color-scheme: dark) { :root { --bg:#12121a; --panel:#1b1b26; --line:#2e2e3e; --text:#ececf4; --muted:#9b9bb2; --accent:#8b8bff; --fill:rgba(139,139,255,.3); --curve:#f87171; --grid:#2a2a38; } }\n  * { box-sizing: border-box; }\n  body { margin: 0; padding: 16px; background: var(--bg); color: var(--text); font: 15px/1.5 system-ui, sans-serif; }\n  h1 { font-size: 20px; margin: 0 0 4px; }\n  p { margin: 0 0 12px; color: var(--muted); }\n  .panel { background: var(--panel); border: 1px solid var(--line); border-radius: 14px; padding: 14px; }\n  canvas { width: 100%; height: 320px; display: block; border-radius: 10px; border: 1px solid var(--line); }\n  .controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 10px 18px; margin-top: 12px; }\n  label { display: grid; gap: 4px; font-size: 14px; font-weight: 600; }\n  input, select { font: inherit; color: inherit; background: var(--panel); border: 1px solid var(--line); border-radius: 8px; padding: 6px 8px; }\n  input[type=range] { padding: 0; accent-color: var(--accent); }\n  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 10px; margin-top: 12px; }\n  .stat { background: var(--bg); border-radius: 10px; padding: 10px; }\n  .stat b { display: block; font-size: 20px; font-variant-numeric: tabular-nums; }\n  .stat span { font-size: 12px; color: var(--muted); }\n  .err { color: var(--curve); font-size: 13px; min-height: 1.2em; }\n</style>\n</head>\n<body>\n<h1>Riemann sum explorer</h1>\n<p>Rectangles estimate the area under the curve. Add more of them and watch the estimate close in on the exact value.</p>\n<div class=\"panel\">\n  <canvas id=\"c\"></canvas>\n  <div class=\"controls\">\n    <label>Function f(x)<input id=\"f\" value=\"x^2\" spellcheck=\"false\" autocapitalize=\"none\"></label>\n    <label>Rectangles: <span id=\"nv\">8</span><input id=\"n\" type=\"range\" min=\"1\" max=\"200\" value=\"8\"></label>\n    <label>Height taken from\n      <select id=\"rule\"><option value=\"left\">left edge</option><option value=\"mid\" selected>middle</option><option value=\"right\">right edge</option></select>\n    </label>\n    <label>From a = <input id=\"a\" type=\"number\" value=\"0\" step=\"0.5\"></label>\n    <label>To b = <input id=\"b\" type=\"number\" value=\"2\" step=\"0.5\"></label>\n  </div>\n  <div class=\"err\" id=\"err\"></div>\n  <div class=\"stats\">\n    <div class=\"stat\"><span>Rectangles add up to</span><b id=\"sum\">–</b></div>\n    <div class=\"stat\"><span>Exact area (numeric)</span><b id=\"exact\">–</b></div>\n    <div class=\"stat\"><span>Error</span><b id=\"diff\">–</b></div>\n  </div>\n</div>\n<script>\n(function () {\n  const $ = (id) => document.getElementById(id);\n  const css = (v) => getComputedStyle(document.documentElement).getPropertyValue(v).trim();\n  let f = (x) => x * x;\n  function compile() {\n    $(\"err\").textContent = \"\";\n    try {\n      if (!window.math) throw new Error(\"math library not loaded; using x^2\");\n      const code = math.compile($(\"f\").value);\n      f = (x) => { const v = code.evaluate({ x }); return typeof v === \"number\" ? v : NaN; };\n      f(0.5);\n    } catch (e) { $(\"err\").textContent = e.message; }\n  }\n  function integrate(a, b) {\n    const n = 2000, h = (b - a) / n; let s = f(a) + f(b);\n    for (let i = 1; i < n; i++) s += f(a + i * h) * (i % 2 ? 4 : 2);\n    return s * h / 3;\n  }\n  function draw() {\n    const c = $(\"c\"), r = c.getBoundingClientRect(), dpr = devicePixelRatio || 1;\n    c.width = r.width * dpr; c.height = r.height * dpr;\n    const g = c.getContext(\"2d\"); g.setTransform(dpr, 0, 0, dpr, 0, 0);\n    const W = r.width, H = r.height;\n    const a = +$(\"a\").value, b = +$(\"b\").value, n = +$(\"n\").value, rule = $(\"rule\").value;\n    $(\"nv\").textContent = n;\n    const pad = (b - a) * 0.25 || 1, x0 = Math.min(a, b) - pad, x1 = Math.max(a, b) + pad;\n    let lo = 0, hi = 0;\n    for (let i = 0; i <= 200; i++) { const y = f(x0 + (x1 - x0) * i / 200); if (isFinite(y)) { lo = Math.min(lo, y); hi = Math.max(hi, y); } }\n    const yp = (hi - lo) * 0.15 || 1; lo -= yp; hi += yp;\n    const X = (x) => (x - x0) / (x1 - x0) * W, Y = (y) => (hi - y) / (hi - lo) * H;\n    g.fillStyle = css(\"--panel\"); g.fillRect(0, 0, W, H);\n    g.strokeStyle = css(\"--grid\"); g.lineWidth = 1; g.beginPath();\n    for (let x = Math.ceil(x0); x <= x1; x++) { g.moveTo(X(x), 0); g.lineTo(X(x), H); }\n    g.stroke();\n    g.strokeStyle = css(\"--muted\"); g.beginPath(); g.moveTo(0, Y(0)); g.lineTo(W, Y(0)); g.stroke();\n    const dx = (b - a) / n; let sum = 0;\n    g.fillStyle = css(\"--fill\"); g.strokeStyle = css(\"--accent\");\n    for (let i = 0; i < n; i++) {\n      const xl = a + i * dx, xs = rule === \"left\" ? xl : rule === \"right\" ? xl + dx : xl + dx / 2;\n      const y = f(xs); if (!isFinite(y)) continue;\n      sum += y * dx;\n      const top = Math.min(Y(y), Y(0)), hgt = Math.abs(Y(y) - Y(0));\n      g.fillRect(X(xl), top, X(xl + dx) - X(xl), hgt);\n      if (n <= 60) g.strokeRect(X(xl), top, X(xl + dx) - X(xl), hgt);\n    }\n    g.strokeStyle = css(\"--curve\"); g.lineWidth = 2.5; g.beginPath();\n    let pen = false;\n    for (let i = 0; i <= 600; i++) { const x = x0 + (x1 - x0) * i / 600, y = f(x); if (!isFinite(y)) { pen = false; continue; } pen ? g.lineTo(X(x), Y(y)) : g.moveTo(X(x), Y(y)); pen = true; }\n    g.stroke();\n    const exact = integrate(a, b);\n    $(\"sum\").textContent = sum.toFixed(5); $(\"exact\").textContent = exact.toFixed(5); $(\"diff\").textContent = Math.abs(sum - exact).toFixed(5);\n  }\n  [\"n\", \"rule\", \"a\", \"b\"].forEach((id) => $(id).addEventListener(\"input\", draw));\n  $(\"f\").addEventListener(\"input\", () => { compile(); draw(); });\n  addEventListener(\"resize\", draw);\n  matchMedia(\"(prefers-color-scheme: dark)\").addEventListener(\"change\", draw);\n  compile(); draw();\n})();\n</script>\n</body>\n</html>\n"
}
